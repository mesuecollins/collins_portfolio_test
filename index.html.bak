<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/vite.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Outfit:wght@500;700;800&display=swap"
    rel="stylesheet">

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />

  <title>Collins Mesue | Cloud & Hardware Engineer</title>
  <meta name="description"
    content="Portfolio of Mesue Collins Asibong - Google Certified Cloud Engineer, Kotlin Multiplatform Specialist, and Hardware Engineer.">
</head>

<body>
  <div id="app">
    <!-- Navigation -->
    <nav class="glass" id="navbar">
      <div class="container nav-content">
        <a href="/" class="logo">Collins Mesue<span class="dot">.</span></a>
        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#speaking">Speaking</a></li>
          <li><a href="#contact" class="btn-primary">Contact</a></li>
        </ul>
        <div class="mobile-toggle" aria-label="Toggle navigation">
          <i class="fa-solid fa-bars"></i>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <header id="hero">
      <div class="container hero-content">
        <div class="hero-text">
          <p class="overline">Hello, I'm</p>
          <h1>Mesue Collins Asibong</h1>
          <h2 class="subtitle">Cloud Engineer <span class="divider">|</span> KMP Specialist <span
              class="divider">|</span> Hardware Engineer</h2>
          <p class="bio-snippet">
            Bridging the gap between physical hardware and cloud-native software.
            From microsoldering logic boards to deploying Kubernetes clusters.
          </p>
          <div class="hero-actions">
            <a href="#projects" class="btn-primary">View Work</a>
            <a href="#about" class="btn-secondary">More About Me</a>
          </div>
        </div>
        <div class="hero-visual">
          <!-- decorative circles -->
          <div class="circle circle-1"></div>
          <div class="circle circle-2"></div>

          <!-- Profile Image -->
          <div class="profile-container">
            <img src="/src/assets/profile.jpg" alt="Collins Mesue" class="profile-img">
          </div>

          <!-- Main Badge -->
          <div class="card-float float-1">
            <i class="fa-brands fa-google"></i>
            <span>Google Certified<br>Cloud Engineer</span>
          </div>

          <!-- New Badges -->
          <div class="card-float float-2">
            <i class="fa-solid fa-headset"></i>
            <span>Google IT Support<br>Specialist</span>
          </div>

          <div class="card-float float-3">
            <i class="fa-brands fa-python"></i>
            <span>PCEP Certified<br>Python Programmer</span>
          </div>

          <div class="card-float float-4">
            <i class="fa-solid fa-microchip"></i>
            <span>Embedded Systems<br>Engineer</span>
          </div>

        </div>
      </div>
      <div class="scroll-indicator">
        <span>Scroll Down</span>
        <i class="fa-solid fa-arrow-down"></i>
      </div>
    </header>

    <!-- Main Content -->
    <main>

      <!-- About Section -->
      <section id="about" class="section">
        <div class="container">
          <h2 class="section-title">About Me</h2>
          <div class="about-grid">
            <div class="about-text">
              <p>
                I am a Computer Engineer with a unique "full-stack" perspective that spans from the silicon level to the
                cloud. My journey began with a strong foundation in Electrical & Electronic Engineering at the
                University of Buea and culminated in a BSc in Computer Engineering from Kampala International
                University.
              </p>
              <p>
                As the founder of <span class="highlight">MacZ Repair</span>, I diagnose and fix complex hardware issues
                at the component level. Simultaneously, I architect scalable cloud solutions as a <span
                  class="highlight">Google Certified Associate Cloud Engineer</span> and build cross-platform mobile
                experiences using the latest in <span class="highlight">Kotlin Multiplatform</span> technology.
              </p>
              <p>
                My goal represents the convergence of hardware excellence and modern software engineering—building
                systems that are robust from the circuit board to the Kubernetes cluster.
              </p>
            </div>
            <div class="about-stats">
              <div class="stat-card glass">
                <h3>7+</h3>
                <p>Years Experience</p>
              </div>
              <div class="stat-card glass">
                <h3>20+</h3>
                <p>Projects Delivered</p>
              </div>
              <div class="stat-card glass">
                <h3>500+</h3>
                <p>Devices Repaired</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Projects Section -->
      <section id="projects" class="section">
        <div class="container">
          <h2 class="section-title">Featured Projects</h2>
          <div class="projects-grid">

            <!-- Project 1 -->
            <article class="project-card glass">
              <div class="project-content">
                <div class="project-header">
                  <h3>TechTrack</h3>
                  <span class="tag">Open Source</span>
                </div>
                <p class="project-desc">A unified shop management system built with <strong>Kotlin
                    Multiplatform</strong> (Android/iOS) and <strong>Firebase</strong>. Handles inventory, ticketing,
                  and repairs tracking.</p>
                <ul class="tech-stack">
                  <li>KMP</li>
                  <li>Compose Multiplatform</li>
                  <li>Firebase</li>
                  <li>Cloud Functions</li>
                </ul>
                <div class="project-links">
                  <a href="#" class="btn-sm"><i class="fa-brands fa-github"></i> Code</a>
                  <a href="#" class="btn-sm"><i class="fa-solid fa-arrow-up-right-from-square"></i> Demo</a>
                </div>
              </div>
            </article>

            <!-- Project 2 -->
            <article class="project-card glass">
              <div class="project-content">
                <div class="project-header">
                  <h3>Campus Connect</h3>
                  <span class="tag">Mobile App</span>
                </div>
                <p class="project-desc">Designed to bridge communication gaps on university campuses. Features real-time
                  messaging, events, and student collaboration tools.</p>
                <ul class="tech-stack">
                  <li>Android</li>
                  <li>Kotlin</li>
                  <li>Real-time DB</li>
                </ul>
                <div class="project-links">
                  <a href="#" class="btn-sm"><i class="fa-brands fa-github"></i> Code</a>
                </div>
              </div>
            </article>

            <!-- Project 3 -->
            <article class="project-card glass">
              <div class="project-content">
                <div class="project-header">
                  <h3>MacZ Repair Diagnostics</h3>
                  <span class="tag">Hardware</span>
                </div>
                <p class="project-desc">Advanced component-level repair services and disaster recovery initiatives.
                  Successfully recovered critical data for businesses affected by Kampala floods.</p>
                <ul class="tech-stack">
                  <li>Microsoldering</li>
                  <li>Schematic Analysis</li>
                  <li>Data Recovery</li>
                </ul>
                <div class="project-links">
                  <a href="#" class="btn-sm"><i class="fa-solid fa-wrench"></i> Services</a>
                </div>
              </div>
            </article>

          </div>
        </div>
      </section>

      <!-- Skills Section -->
      <section id="skills" class="section">
        <div class="container">
          <h2 class="section-title">Technical Expertise</h2>
          <div class="skills-grid">

            <!-- Mobile -->
            <div class="skill-category glass">
              <div class="icon-box"><i class="fa-brands fa-android"></i></div>
              <h3>Mobile Development</h3>
              <ul>
                <li>Kotlin Multiplatform (KMP)</li>
                <li>Jetpack Compose</li>
                <li>Android SDK</li>
                <li>Compose Multiplatform</li>
              </ul>
            </div>

            <!-- Cloud -->
            <div class="skill-category glass">
              <div class="icon-box"><i class="fa-brands fa-google"></i></div>
              <h3>Cloud Engineering</h3>
              <ul>
                <li>Google Cloud (GCP)</li>
                <li>Kubernetes (GKE)</li>
                <li>Cloud Run & Functions</li>
                <li>Terraform (IaC)</li>
              </ul>
            </div>

            <!-- DevOps -->
            <div class="skill-category glass">
              <div class="icon-box"><i class="fa-solid fa-server"></i></div>
              <h3>DevOps</h3>
              <ul>
                <li>CI/CD (GitHub Actions)</li>
                <li>Docker & Containers</li>
                <li>Infrastructure Automation</li>
              </ul>
            </div>

            <!-- Hardware -->
            <div class="skill-category glass">
              <div class="icon-box"><i class="fa-solid fa-microchip"></i></div>
              <h3>Hardware Engineering</h3>
              <ul>
                <li>Microsoldering</li>
                <li>Logic Board Diagnostics</li>
                <li>Schematic Analysis</li>
                <li>Hardware Repair</li>
              </ul>
            </div>

          </div>
        </div>
      </section>

      <!-- Speaking Section -->
      <section id="speaking" class="section">
        <div class="container">
          <h2 class="section-title">Speaking & Community</h2>
          <div class="speaking-layout">
            <div class="talks-list">
              <h3>Featured Talks</h3>
              <div class="talk-item glass">
                <span class="date">2025</span>
                <h4>AI-Powered Android UI</h4>
                <p>Integrating Gemini AI with Jetpack Compose for dynamic UI generation.</p>
              </div>
              <div class="talk-item glass">
                <span class="date">2025</span>
                <h4>Mastering Navigation with Jetpack Compose</h4>
                <p>Deep dive into complex navigation graphs and data passing.</p>
              </div>
              <div class="talk-item glass">
                <span class="date">2024</span>
                <h4>Deploy Kubernetes Load Balancer with Terraform</h4>
                <p>DevOps workshop on GCP infrastructure-as-code.</p>
              </div>
            </div>

            <div class="affiliations glass">
              <h3>Affiliations</h3>
              <ul class="affiliations-list">
                <li>
                  <i class="fa-solid fa-users"></i>
                  <div>
                    <strong>Google Developer Student Clubs (GDSC)</strong>
                    <span>Alumnus & Core Team Member</span>
                  </div>
                </li>
                <li>
                  <i class="fa-solid fa-microphone"></i>
                  <div>
                    <strong>Google Developer Groups (GDG)</strong>
                    <span>Active Speaker (DevFest Kampala)</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Education Section -->
      <section id="education" class="section">
        <div class="container">
          <h2 class="section-title">Education & Certifications</h2>
          <div class="education-grid">
            <div class="edu-card glass">
              <h4>BSc Computer Engineering</h4>
              <p>Kampala International University (2025)</p>
            </div>
            <div class="edu-card glass">
              <h4>Google Certified Associate Cloud Engineer</h4>
              <p>Active Certification</p>
            </div>
            <div class="edu-card glass">
              <h4>Electrical & Electronic Engineering</h4>
              <p>University of Buea, Cameroon</p>
            </div>
          </div>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer id="contact">
      <div class="container footer-content">
        <div class="footer-left">
          <h3>Let's Connect</h3>
          <p>Open for opportunities in Cloud Engineering, KMP, and Hardware Diagnostics.</p>
          <div class="social-links">
            <a href="https://www.linkedin.com/in/collins-m-b45837103/" class="social-icon" target="_blank"
              rel="noopener noreferrer"><i class="fa-brands fa-linkedin"></i></a>
            <a href="#" class="social-icon"><i class="fa-brands fa-github"></i></a>
            <a href="#" class="social-icon"><i class="fa-brands fa-twitter"></i></a>
            <a href="mailto:contact@collinsmesue.com" class="social-icon"><i class="fa-solid fa-envelope"></i></a>
          </div>
        </div>
        <div class="footer-right">
          <p>Location: Ishaka, Bushenyi, Uganda</p>
          <p>&copy; 2026 Collins Mesue. Built with Vite & &hearts;</p>
        </div>
      </div>
    </footer>
  </div>
  <script type="module" src="/src/main.js"></script>
</body>

</html>